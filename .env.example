# CrewNest environment — copy to .env.local and fill in. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# --- Supabase (SERVER ONLY — bypasses RLS; never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- LLM master fallback (used when a tenant has no BYOK key) ---
MASTER_OPENAI_KEY=sk-...

# --- Meta (server only) ---
# Verify token: any random string; must match what you set in the Meta webhook config.
META_VERIFY_TOKEN=choose-a-long-random-string
# App secret: from Meta App > Settings > Basic. Used to verify X-Hub-Signature-256.
META_APP_SECRET=YOUR-META-APP-SECRET
# Graph API version (pin it).
META_GRAPH_VERSION=v21.0

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Error tracking (optional — no-op until set; docs/17 S2) ---
# SENTRY_DSN=https://YOUR-KEY@oYOUR-ORG.ingest.sentry.io/YOUR-PROJECT

# --- Daily maintenance cron auth (optional — rejects all requests until set; docs/17 §3.1) ---
# Generate a random string, set it here AND as a Vercel env var of the same name.
# CRON_SECRET=choose-a-long-random-string

