# ClerkNest environment — copy to .env.local and fill in. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# --- Supabase (SERVER ONLY — bypasses RLS; never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- LLM master fallback (used when a tenant has no BYOK key) ---
# Set the one that matches a tenant's llm_provider. The live demo runs on OpenRouter.
MASTER_OPENAI_KEY=sk-...
MASTER_OPENROUTER_KEY=sk-or-...

# --- Email notifications via Resend (optional but recommended; services/email.ts, docs/14 §3.4) ---
# Until a sending domain is verified in Resend, mail only reaches the account owner via onboarding@resend.dev.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=ClerkNest <notifications@your-verified-domain.com>

# --- Meta (server only) ---
# Verify token: any random string; must match what you set in the Meta webhook config.
META_VERIFY_TOKEN=choose-a-long-random-string
# App secret: from Meta App > Settings > Basic. Used to verify X-Hub-Signature-256.
META_APP_SECRET=YOUR-META-APP-SECRET
# Graph API version (pin it).
META_GRAPH_VERSION=v21.0
# Facebook Login for Business (docs/27 §5 C2) — powers the "Connect with
# Facebook" button on the client dashboard's Channels screen. From Meta App >
# Settings > Basic (the App ID, not the secret above). Unset => that button's
# initiate route refuses with a clear error; Messenger/Instagram fall back to
# the manual concierge request flow.
# META_APP_ID=YOUR-META-APP-ID
# Optional — WhatsApp Embedded Signup configuration id (Meta app → WhatsApp →
# Embedded Signup). Unset => Connect WhatsApp uses OAuth scopes instead.
# META_WHATSAPP_CONFIG_ID=YOUR-CONFIG-ID
# Optional — "Connect with Instagram" (no Facebook Page required), via Meta's
# Instagram API with Instagram Login. From Meta App > Instagram > API setup
# with Instagram login > Business login settings — a DIFFERENT id/secret pair
# from META_APP_ID/META_APP_SECRET above, even though it's the same App.
# Unset => that button's initiate route refuses with a clear error; the
# Facebook-Page-linked Instagram path (META_APP_ID above) is unaffected.
# INSTAGRAM_APP_ID=YOUR-INSTAGRAM-APP-ID
# INSTAGRAM_APP_SECRET=YOUR-INSTAGRAM-APP-SECRET

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Error tracking (optional — no-op until set; docs/17 S2) ---
# SENTRY_DSN=https://YOUR-KEY@oYOUR-ORG.ingest.sentry.io/YOUR-PROJECT

# --- Cron auth (rejects all requests until set; docs/17 §3.1) ---
# Guards BOTH /api/cron/maintenance AND /api/cron/follow-ups.
# Generate a random string, set it here, as a Vercel env var of the same name, AND mirror the
# same value into Supabase Vault so the pg_cron follow-ups job can authenticate (see handoff.md §4a/§5).
# CRON_SECRET=choose-a-long-random-string


# --- Web Push (optional — push is a no-op until all four are set; docs/21) ---
# Generate a keypair with:  npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is SERVER-ONLY and must never be exposed to the browser.
# Only NEXT_PUBLIC_VAPID_PUBLIC_KEY reaches the client — that asymmetry is the
# whole point of VAPID and is safe by design. The public key goes in BOTH vars.
# VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
# VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
# VAPID_SUBJECT=mailto:you@yourdomain.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY


# --- SaaS billing: Stripe (international tenants; docs/22) ---
# Unlike Resend/push, billing FAILS LOUDLY when unset: checkout/portal refuse with a clear
# error rather than silently no-op-ing. A paywall that appears to work but never charges is
# the worse failure. Prices are Stripe Price ids (price_...), not amounts.
# STRIPE_SECRET_KEY=sk_test_YOUR-KEY
# STRIPE_WEBHOOK_SECRET=whsec_YOUR-SIGNING-SECRET
# STRIPE_PRICE_STARTER=price_YOUR-STARTER-PRICE-ID
# STRIPE_PRICE_PRO=price_YOUR-PRO-PRICE-ID

# --- SaaS billing: Safepay (Pakistani tenants; docs/25) ---
# Stripe cannot onboard Pakistan-based merchants, so PK tenants bill through Safepay.
# Routing is by tenants.billing_country ('PK' => safepay), never tenant choice.
# SAFEPAY_PLAN_* are Safepay Plan ids (plan_...) created in their merchant dashboard —
# the plan carries the amount and currency, so repricing means editing the plan there AND
# `pricePkr` in services/demo/plans.ts (docs/25 §3.2).
# SAFEPAY_ENVIRONMENT defaults to 'sandbox' so a half-configured deploy can never take real money.
# SAFEPAY_SECRET_KEY=sec_YOUR-API-KEY
# SAFEPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SIGNING-SECRET
# SAFEPAY_PLAN_STARTER=plan_YOUR-STARTER-PLAN-ID
# SAFEPAY_PLAN_PRO=plan_YOUR-PRO-PLAN-ID
# SAFEPAY_ENVIRONMENT=sandbox
# SAFEPAY_USD_TO_PKR=278

# --- Growth tier ($49) price/plan ids (docs/26) ---
# Added alongside the Growth tier. Same fail-loud posture: unset => Growth checkout
# refuses with a clear error. NOTE: repricing Starter $29 -> $39 is NOT a code-only
# change — the amount lives in the Stripe Price / Safepay Plan, not in plans.ts.
# STRIPE_PRICE_GROWTH=price_YOUR-GROWTH-PRICE-ID
# SAFEPAY_PLAN_GROWTH=plan_YOUR-GROWTH-PLAN-ID
