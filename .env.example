# CrewNest environment — copy to .env.local and fill in. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# --- Supabase (SERVER ONLY — bypasses RLS; never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- LLM master fallback (used when a tenant has no BYOK key) ---
# Set the one that matches a tenant's llm_provider. The live demo runs on OpenRouter.
MASTER_OPENAI_KEY=sk-...
MASTER_OPENROUTER_KEY=sk-or-...

# --- Email notifications via Resend (optional but recommended; services/email.ts, docs/14 §3.4) ---
# Until a sending domain is verified in Resend, mail only reaches the account owner via onboarding@resend.dev.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=CrewNest <notifications@your-verified-domain.com>

# --- Meta (server only) ---
# Verify token: any random string; must match what you set in the Meta webhook config.
META_VERIFY_TOKEN=choose-a-long-random-string
# App secret: from Meta App > Settings > Basic. Used to verify X-Hub-Signature-256.
META_APP_SECRET=YOUR-META-APP-SECRET
# Graph API version (pin it).
META_GRAPH_VERSION=v21.0

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Error tracking (optional — no-op until set; docs/17 S2) ---
# SENTRY_DSN=https://YOUR-KEY@oYOUR-ORG.ingest.sentry.io/YOUR-PROJECT

# --- Cron auth (rejects all requests until set; docs/17 §3.1) ---
# Guards BOTH /api/cron/maintenance AND /api/cron/follow-ups.
# Generate a random string, set it here, as a Vercel env var of the same name, AND mirror the
# same value into Supabase Vault so the pg_cron follow-ups job can authenticate (see handoff.md §4a/§5).
# CRON_SECRET=choose-a-long-random-string


# --- Web Push (optional — push is a no-op until all four are set; docs/21) ---
# Generate a keypair with:  npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is SERVER-ONLY and must never be exposed to the browser.
# Only NEXT_PUBLIC_VAPID_PUBLIC_KEY reaches the client — that asymmetry is the
# whole point of VAPID and is safe by design. The public key goes in BOTH vars.
# VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
# VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
# VAPID_SUBJECT=mailto:you@yourdomain.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
